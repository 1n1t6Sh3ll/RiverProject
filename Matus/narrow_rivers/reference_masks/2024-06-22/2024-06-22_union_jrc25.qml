<!DOCTYPE qgis>
<qgis version="3.28">
  <pipe>
    <rasterrenderer type="paletted" band="1" opacity="1" nodataColor="">
      <colorPalette>
        <paletteEntry value="0" color="#000000" alpha="0" label="0 land"/>
        <paletteEntry value="1" color="#2ca02c" alpha="255" label="1 RF only"/>
        <paletteEntry value="2" color="#ff7f0e" alpha="255" label="2 JRC only (added by union)"/>
        <paletteEntry value="3" color="#1f5fbf" alpha="255" label="3 both"/>
        <paletteEntry value="9" color="#9e9e9e" alpha="120" label="9 unknown"/>
      </colorPalette>
    </rasterrenderer>
  </pipe>
</qgis>
